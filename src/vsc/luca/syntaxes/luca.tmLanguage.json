{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "luca",
  "scopeName": "source.luca",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.luca",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.luca",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.luca",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.luca",
          "match": "\\b(if|then|else)\\b"
        },
        {
          "name": "keyword.other.luca",
          "match": "\\b(let|in|lambda)\\b|\\\\"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.luca",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.luca",
          "match": "\\b(int|bool|string)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.luca",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?:-+[a-zA-Z0-9_]+)*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.luca",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.luca",
          "match": "->|!=|>=|<=|[+\\-*/=<>.,:()]"
        }
      ]
    }
  }
}