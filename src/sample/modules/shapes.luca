// shapes.luca - a module exporting a type and functions over it
//
// `export let name = E in ()` makes the binding available to importers; the
// innermost body (()) is just the module's standalone value. Exports chain:
// each one's body is the next `export let ...`.

type shape = Circle of int | Square | Rect of (int, int)

export let area = \s:shape. match s with
    Circle r . 3 * r * r
  | Square . 100
  | Rect (w, h). w * h
in
// exported definitions may reference the module's earlier exports
export let bigger = \s:shape. \n:int. match s with
    Circle r . Circle (r + n)
  | Square . Square
  | Rect (w, h). Rect (w + n, h + n)
in
export let total-area = \a:shape. \b:shape. area a + area b in ()
