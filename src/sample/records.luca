// records.luca - user-defined record types
//
// `type point = {x:int, y:int}` declares a NOMINAL record type, distinct from the
// anonymous `{x:int, y:int}`. Only a literal whose fields match by name and type can
// initialize it - in any field order (the literal is rebuilt in declaration order).
// Any other value must have the exact same type.
// Field and let annotations are optional: an absent annotation takes the value's type.

type point = {x:int, y:int}
type segment = {a:point, b:point}

let origin : point = {x = 0, y = 0} in             // annotated let + literal init
let move = \p : point . \dx : int . \dy : int .    // record as argument,
  {x = p.x + dx, y = p.y + dy} in                  // anonymous record as result
let p = move {y = 5, x = 3} 1 1 in                 // reordered fields initialize point
let diag : segment = {b = {x = 8, y = 6},          // nested init, b before a
                      a = origin} in
let mid = \s : segment .                           // chained field access s.a.x
  {x = (s.a.x + s.b.x) / 2, y = (s.a.y + s.b.y) / 2} in
let {mx, my} = mid diag in                         // structured binding
let {px, py} = p in
let manhattan = (if mx > px then mx - px else px - mx) +
                (if my > py then my - py else py - my) in
manhattan
